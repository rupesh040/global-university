            "items": [
              {
                "id": "1",
                "number": "01",
                "question": "How do I apply for undergraduate or graduate admissions at Global?",
                "answer": "Applications can be submitted directly online through our digital portal. You will need official academic transcripts, letters of recommendation, and a personal statement outlining your academic goals.",
                "category": "Admissions"
              },
              {
                "id": "2",
                "number": "02",
                "question": "What financial aid and scholarship opportunities are available?",
                "answer": "Global University awards both merit-based academic scholarships and need-based tuition grants. Over 85% of incoming scholars receive institutional financial assistance upon application review.",
                "category": "Financial Aid"
              },
              {
                "id": "3",
                "number": "03",
                "question": "Can international students participate in global study exchange programs?",
                "answer": "Yes! Global maintains active exchange partnerships with renowned universities in over 30 countries worldwide. International students can participate in semester-abroad or summer immersion tracks.",
                "category": "Global Exchange"
              },
              {
                "id": "4",
                "number": "04",
                "question": "What campus housing and residential accommodation options exist?",
                "answer": "We offer contemporary on-campus residence halls, suite-style dorms for upperclassmen, and quiet graduate apartments complete with high-speed internet, collaborative study spaces, and dining plans.",
                "category": "Campus Life"
              },
              {
                "id": "5",
                "number": "05",
                "question": "How can I schedule an official in-person or virtual campus tour?",
                "answer": "Campus tours run weekly from Monday through Saturday. You can book an appointment online or contact our admissions office directly at +1 000-000-000 or via email at info@xyz.com.",
                "category": "Campus Visits"
              }
            ]
          }
        }
